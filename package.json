{
  "name": "zalo-lite",
  "type": "module",
  "private": true,
  "version": "0.1.1",
  "description": "Lightweight unofficial desktop client for Zalo messaging (Tauri + Bun)",
  "license": "MIT",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "server": "bun server/index.ts",
    "sidecar": "bun build --compile --minify server/index.ts --outfile src-tauri/binaries/zalo-lite-server-$(rustc -vV | sed -n \"s/host: //p\")",
    "dev": "bun run sidecar && tauri dev",
    "build": "bun run sidecar && tauri build",
    "test": "bun test server src",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "preact": "^11.1.1",
    "xz-decompress": "^0.2.3",
    "zca-js": "^2.2.0"
  }
}
